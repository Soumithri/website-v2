{
  "name": "soumithri-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npx tailwindcss -i ./src/styles/input.css -o ./_site/styles.css -w\" \"eleventy --serve\"",
    "build:css": "npx tailwindcss -i ./src/styles/input.css -o ./_site/styles.css",
    "build": "eleventy",
    "start": "eleventy --serve"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@tailwindcss/cli": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3"
  }
}
